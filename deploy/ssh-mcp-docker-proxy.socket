# Read-only Docker proxy for ssh-mcp's docker_ps / docker_logs tools.
# Only agent-ro can open this socket; the Docker socket itself stays
# root/docker-only. Installed by bootstrap-target.sh with DOCKER_PROXY=1.
[Unit]
Description=ssh-mcp read-only Docker proxy socket

[Socket]
ListenStream=/run/ssh-mcp/docker.sock
SocketUser=root
SocketGroup=agent-ro
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
