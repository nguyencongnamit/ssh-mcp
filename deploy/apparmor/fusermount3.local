# Additions to Ubuntu's fusermount3 AppArmor profile for ssh-mcp.
#
# Newer Ubuntu releases (26.04, not 24.04) confine fusermount3 to a fixed
# set of mount points (see /etc/apparmor.d/fusermount3). ssh-mcp mounts its read-only sshfs
# mirrors under its data_dir. These rules allow that directory only.
#
# Install:  sudo install -m 0644 fusermount3.local /etc/apparmor.d/local/fusermount3
#           sudo apparmor_parser -r /etc/apparmor.d/fusermount3
# Adjust the path if data_dir is not /var/lib/ssh-mcp.

mount fstype=fuse.sshfs -> /var/lib/ssh-mcp/mirrors/**/,
umount /var/lib/ssh-mcp/mirrors/**/,
